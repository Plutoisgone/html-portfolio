# Mini-SIEM Phase 0.1 deployment settings (non-secret). Copy to .env and fill in.
# Secrets live in ./secrets/ (created by setup.sh), never in this file.

# DNS name staff use to reach the dashboard (must resolve to this server).
SIEM_HOSTNAME=CHANGE_ME
# Explicit host management-interface IPv4 address, never 0.0.0.0.
SIEM_BIND_IP=CHANGE_ME

# TLS: "internal" = Caddy's own private CA (lab). For production, put your
# company certificate in ./caddy/certs/ and set: /certs/cert.pem /certs/key.pem
SIEM_TLS=internal

# Entra ID app registration (see README section 4).
SIEM_OIDC_TENANT_ID=CHANGE_ME
SIEM_OIDC_CLIENT_ID=CHANGE_ME

# Entra object UUID of the initial super admin (first sign-in only).
SIEM_INITIAL_SUPER_ADMIN_OIDS=CHANGE_ME

# Optional: require the "mfa" value in the ID token amr claim. Leave false and
# enforce MFA with Entra Conditional Access instead (recommended).
SIEM_REQUIRE_MFA_CLAIM=false

# Session limits.
SIEM_SESSION_IDLE_MINUTES=30
SIEM_SESSION_ABSOLUTE_HOURS=10

# Immutable audit copy: S3 bucket created WITH Object Lock enabled (e.g. Wasabi).
# Leave SIEM_S3_BUCKET empty to disable (not recommended beyond a lab).
SIEM_S3_ENDPOINT=
SIEM_S3_REGION=
SIEM_S3_BUCKET=
SIEM_AUDIT_RETENTION_DAYS=365

# External dead-man's switch URL to ping every 5 minutes (e.g. a healthchecks.io check).
SIEM_HEARTBEAT_URL=

# Internal Docker subnet for the web tier. Change only if it clashes with your LAN.
EDGE_SUBNET=172.31.250.0/28
CADDY_IP=172.31.250.2
EDGE_DYNAMIC_RANGE=172.31.250.8/29
BACKEND_SUBNET=172.31.250.32/27
# Collector <-> PostgreSQL network (pg_hba admits only the ingest role from here).
COLLECT_DB_SUBNET=172.31.250.64/28

# Database role names.
SIEM_DB_OWNER_USER=siem_owner
SIEM_DB_APP_USER=siem_app
SIEM_DB_WORKER_USER=siem_worker
SIEM_DB_EMERGENCY_USER=siem_emergency

# Host folder for persistent data.
DATA_DIR=/opt/mini-siem/data

# ClickHouse resource limits (raise on bigger servers; CPUs must not exceed the VM's vCPUs).
CLICKHOUSE_CPUS=2
CLICKHOUSE_MEMORY=4G
